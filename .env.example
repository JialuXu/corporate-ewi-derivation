# Copy this file to .env.local and fill in the values you need.
# .env.local is gitignored; this template (.env.example) is committed.
#
# Pydantic-settings reads with prefix AD_, so e.g. `llm_api_key` ←→ AD_LLM_API_KEY.

# ---- LLM provider (OpenAI-compatible endpoint) ---------------------------
# Required for `derive explain`, `derive search --coach real`, and
# `derive analysis report` / `suspect`.
AD_LLM_API_KEY=
AD_LLM_BASE_URL=https://api.deepseek.com
AD_LLM_MODEL=deepseek-v4-pro

# ---- Atomic-metric inventory ---------------------------------------------
# Defaults to the committed demo inventory data/registry/metrics.example.csv
# (76 institution-neutral rows) so a fresh clone runs out of the box.
# The full inventory is a production table schema — keep it OUT of the repo
# and point this at your local copy (or drop it at data/registry/metrics.csv,
# which is gitignored and picked up automatically).
# AD_REGISTRY_CSV=/absolute/path/to/原子指标清单.csv

# ---- Optional overrides --------------------------------------------------
# Defaults are sensible; uncomment only if you want to change them.
# AD_RANDOM_SEED=20260429
# AD_N_SYNTHETIC_CUSTOMERS=500
# AD_N_SYNTHETIC_MONTHS=24
# AD_MAX_TREE_DEPTH=5
# AD_MAX_TREE_LEAVES=8
